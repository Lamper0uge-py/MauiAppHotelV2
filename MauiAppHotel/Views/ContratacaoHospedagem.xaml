<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource OffBlack}">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">

        <Label Text="Cálculo da Diária"
               FontFamily="LancelotRegular"
               FontSize="50"
               TextColor="{StaticResource AntiqueGold}" />

        <Frame Padding="10"
               BackgroundColor="{StaticResource Charcoal}">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos:" />

                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="{StaticResource AntiqueGold}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças:" />

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="{StaticResource AntiqueGold}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />
                </Grid>

                <Label Text="Escolha sua Suíte"
                       FontAttributes="Bold" />

                <Picker x:Name="pck_quarto"
                        Title="Selecione sua Acomodação"
                        ItemDisplayBinding="{Binding Descricao}" />

                <Frame Padding="10"
                       Margin="10"
                       BackgroundColor="{StaticResource Charcoal}">
                    <VerticalStackLayout>
                        <Label Text="Período da Estadia"
                               FontAttributes="Bold" />
                        
                        <HorizontalStackLayout>
                            <Label Text="Check-in:" />
                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Margin="10">
                            <Label Text="Check-out:" />
                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Avançar"
                        Clicked="btn_avancar_Clicked"
                        FontSize="15"
                        FontAttributes="Bold"
                        Margin="15"
                        TextColor="{StaticResource AntiqueGold}"
                        BackgroundColor="{StaticResource DarkWine}" />

                <Button Text="Contato e Suporte"
                        Clicked="btn_suporte_Clicked"
                        FontSize="15"
                        FontAttributes="Bold"
                        Margin="15"
                        TextColor="{StaticResource AntiqueGold}"
                        BackgroundColor="{StaticResource MidnightBlue}" />

                <Button Text="Sobre"
                        Clicked="btn_sobre_Clicked"
                        FontSize="15"
                        FontAttributes="Bold"
                        Margin="15"
                        TextColor="{StaticResource GothicSilver}"
                        BackgroundColor="{StaticResource MidnightBlue}" />

            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>

</ContentPage>